@startuml class_post
title Post / Group Posts Module - Class Diagram (BLL: PostService / DAL: PostRepository)
hide circle
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor white
  BorderColor black
  FontName "Arial"
  FontStyle bold
}

package "FE.Web (MVC)" {
  class "Web.PostsController" as WebPosts {
    -_api : ApiClient
    +Details(id : Guid) : IActionResult
    +Create(content : String, groupId : Guid,\n media : IFormFile, returnUrl : String) : IActionResult
    +Edit(id : Guid, content : String, media : IFormFile, ...) : IActionResult
    +Delete(id : Guid, returnUrl : String) : IActionResult
    +React(id : Guid, type : int) : IActionResult
    +Comment(id : Guid, content : String) : IActionResult
    -Back(returnUrl : String, groupId : Guid) : IActionResult
  }
  class ApiClient {
    +GetFeedAsync(page, pageSize) : PagedResult<PostResponse>
    +GetGroupFeedAsync(groupId, page, pageSize) : PagedResult<PostResponse>
    +CreatePostAsync(req : CreatePostRequest) : Guid
    +UpdatePostAsync(id, req) : void
    +DeletePostAsync(id) : void
    +UploadAsync(stream, fileName, contentType) : MediaUploadResult
  }
}

package "API (Presentation)" {
  class PostsController {
    -_postService : IPostService
    +CurrentUserId : String
    +Feed(query : PostQuery) : IActionResult
    +Get(id : Guid) : IActionResult
    +Create(request : CreatePostRequest) : IActionResult
    +Update(id : Guid, request : CreatePostRequest) : IActionResult
    +Delete(id : Guid) : IActionResult
  }
  class GroupPostsController {
    -_service : IPostService
    +CurrentUserId : String
    +GetFeed(groupId : Guid, query : PostQuery) : IActionResult
    +Create(groupId : Guid, request : CreatePostRequest) : IActionResult
    +Delete(groupId : Guid, postId : Guid) : IActionResult
  }
}

package "Application (BLL)" {
  interface IPostService {
    +CreateAsync(request, userId) : Guid
    +GetFeedAsync(query) : PagedResult<PostResponse>
    +GetByIdAsync(postId) : PostResponse
    +UpdateAsync(postId, request, userId) : Task
    +DeleteAsync(postId, userId) : Task
    +CreateGroupPostAsync(groupId, request, userId) : Guid
    +GetGroupFeedAsync(groupId, query) : PagedResult<PostResponse>
    +DeleteGroupPostAsync(groupId, postId, userId) : Task
  }
  class PostService {
    -_postRepository : IPostRepository
    -_groupRepository : IGroupRepository
    -_contentFilter : IContentFilter
    +CreateAsync(request, userId) : Guid
    +GetFeedAsync(query) : PagedResult<PostResponse>
    +GetByIdAsync(postId) : PostResponse
    +UpdateAsync(postId, request, userId) : Task
    +DeleteAsync(postId, userId) : Task
    +CreateGroupPostAsync(groupId, request, userId) : Guid
    +GetGroupFeedAsync(groupId, query) : PagedResult<PostResponse>
    +DeleteGroupPostAsync(groupId, postId, userId) : Task
    -GetOwnedPostAsync(postId, userId) : Post
    -GetActiveGroupAsync(groupId) : Group
    -ValidateContent(request : CreatePostRequest) : void
    -{static} BuildPost(request, userId, groupId) : Post
    -{static} Map(post : Post) : PostResponse
  }
  interface IContentFilter {
    +IsAllowed(content : String) : bool
  }
}

package "Application.DTOs" {
  class CreatePostRequest {
    +GroupId : Guid
    +Content : String
    +MediaUrl : String
    +MediaType : int
  }
  class PostQuery {
    +Page : int
    +PageSize : int
  }
  class PostResponse {
    +Id : Guid
    +GroupId : Guid
    +UserId : String
    +AuthorName : String
    +AuthorAvatarUrl : String
    +GroupName : String
    +Content : String
    +MediaUrl : String
    +MediaType : int
    +CreatedDate : DateTime
    +CommentCount : int
    +ReactionCount : int
    +ReactionCounts : Dictionary<int,int>
  }
}

package "Infrastructure (DAL)" {
  interface IPostRepository {
    +GetFeedAsync(query) : PagedResult<Post>
    +GetGroupFeedAsync(groupId, query) : PagedResult<Post>
    +GetByIdAsync(id : Guid) : Post
    +AddAsync(post : Post) : Task
    +SaveChangesAsync() : Task
  }
  class PostRepository {
    -_context : AppDbContext
    +GetFeedAsync(query) : PagedResult<Post>
    +GetGroupFeedAsync(groupId, query) : PagedResult<Post>
    +GetByIdAsync(id : Guid) : Post
    +AddAsync(post : Post) : Task
    +SaveChangesAsync() : Task
    -{static} PageAsync(queryable, query) : PagedResult<Post>
  }
  class AppDbContext {
    +Posts : DbSet<Post>
    +Groups : DbSet<Group>
  }
}

package "Domain (Entities)" {
  class Post {
    +Id : Guid
    +UserId : String
    +GroupId : Guid
    +Content : String
    +MediaUrl : String
    +MediaType : int
    +CreatedDate : DateTime
    +UpdatedDate : DateTime
    +IsDeleted : bool
    +Comments : ICollection<Comment>
    +Reactions : ICollection<Reaction>
  }
}

WebPosts --> ApiClient
ApiClient ..> PostsController : HTTP/JSON
ApiClient ..> GroupPostsController : HTTP/JSON
PostsController --> IPostService
GroupPostsController --> IPostService
PostService ..|> IPostService
PostService --> IPostRepository
PostService --> IContentFilter
PostRepository ..|> IPostRepository
PostRepository --> AppDbContext
AppDbContext --> Post
PostService ..> CreatePostRequest
PostService ..> PostResponse
PostService ..> Post
PostsController ..> PostQuery
@enduml
