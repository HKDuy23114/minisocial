@startuml class_admin
title Admin Module (Dashboard / Stats / Posts-per-day / Users) - Class Diagram
hide circle
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor white
  BorderColor black
  FontName "Arial"
  FontStyle bold
}

package "FE.Web (MVC)" {
  class "Web.AdminController" as WebAdmin {
    -_api : ApiClient
    +Index(keyword : String, page : int) : IActionResult
    +DeleteUser(id : String, keyword : String) : IActionResult
  }
  class ApiClient {
    +GetStatsAsync() : DashboardStatsResponse
    +GetPostsPerDayAsync(days : int) : List<PostsPerDayItem>
    +GetUsersAsync(keyword, page, pageSize) : PagedResult<UserResponse>
    +DeleteUserAsync(id : String) : void
  }
}

package "API (Presentation)" {
  class AdminController {
    -_service : IAdminService
    +GetStats() : IActionResult
    +GetPostsPerDay(days : int) : IActionResult
    +GetUsers(query : UserQuery) : IActionResult
    +DeleteUser(userId : String) : IActionResult
  }
  note top of AdminController : [Authorize(Roles = "Admin")]
}

package "Application (BLL)" {
  interface IAdminService {
    +GetStatsAsync() : DashboardStatsResponse
    +GetPostsPerDayAsync(days : int) : List<PostsPerDayItem>
    +GetUsersAsync(query : UserQuery) : PagedResult<UserResponse>
    +DeleteUserAsync(userId : String) : Task
  }
  class AdminService {
    -_repo : IAdminRepository
    +GetStatsAsync() : DashboardStatsResponse
    +GetPostsPerDayAsync(days : int) : List<PostsPerDayItem>
    +GetUsersAsync(query : UserQuery) : PagedResult<UserResponse>
    +DeleteUserAsync(userId : String) : Task
    -{static} MapToResponse(u : AppUser) : UserResponse
  }
}

package "Application.DTOs" {
  class DashboardStatsResponse {
    +TotalUsers : int
    +TotalPosts : int
    +TotalComments : int
    +TotalGroups : int
  }
  class PostsPerDayItem {
    +Date : DateTime
    +Count : int
  }
  class UserQuery {
    +Keyword : String
    +Page : int
    +PageSize : int
  }
  class UserResponse {
    +Id : String
    +UserName : String
    +Email : String
    +DisplayName : String
    +AvatarUrl : String
    +CreatedDate : DateTime
  }
}

package "Infrastructure (DAL)" {
  interface IAdminRepository {
    +GetStatsAsync() : DashboardStatsResponse
    +GetPostsPerDayAsync(days : int) : List<PostsPerDayItem>
    +GetUsersAsync(query : UserQuery) : PagedResult<AppUser>
    +GetUserByIdAsync(id : String) : AppUser
    +SaveChangesAsync() : Task
  }
  class AdminRepository {
    -_context : AppDbContext
    +GetStatsAsync() : DashboardStatsResponse
    +GetPostsPerDayAsync(days : int) : List<PostsPerDayItem>
    +GetUsersAsync(query : UserQuery) : PagedResult<AppUser>
    +GetUserByIdAsync(id : String) : AppUser
    +SaveChangesAsync() : Task
  }
  class AppDbContext {
    +Users : DbSet<AppUser>
    +Posts : DbSet<Post>
    +Comments : DbSet<Comment>
    +Groups : DbSet<Group>
  }
}

WebAdmin --> ApiClient
ApiClient ..> AdminController : HTTP/JSON
AdminController --> IAdminService
AdminService ..|> IAdminService
AdminService --> IAdminRepository
AdminRepository ..|> IAdminRepository
AdminRepository --> AppDbContext
AdminService ..> DashboardStatsResponse
AdminService ..> PostsPerDayItem
AdminService ..> UserResponse
AdminController ..> UserQuery
@enduml
