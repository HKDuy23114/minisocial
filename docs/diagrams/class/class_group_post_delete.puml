@startuml class_group_post_delete
hide circle
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor white
  BorderColor black
  FontName "Arial"
  FontStyle bold
}
title Class Diagram - Delete Group Post (soft delete)

class GroupPostsController {
  -_service : IPostService
  +Delete(groupId : Guid, postId : Guid) : Task<IActionResult>
}

class PostService {
  -_postRepo : IPostRepository
  -_groupRepo : IGroupRepository
  +DeleteGroupPostAsync(groupId : Guid,\n postId : Guid, userId : string) : Task
  -GetActiveGroupAsync(groupId : Guid) : Task<Group>
}

class PostRepository {
  -_context : AppDbContext
  +GetByIdAsync(id : Guid) : Task<Post>
  +SaveChangesAsync() : Task
}
class GroupRepository {
  -_context : AppDbContext
  +GetByIdAsync(id : Guid) : Task<Group>
}
class AppDbContext {
  +Posts : DbSet<Post>
  +Groups : DbSet<Group>
  +SaveChangesAsync() : Task<int>
}

class Post {
  -Id : Guid
  -UserId : String
  -GroupId : Guid?
  -IsDeleted : bool
}
class Group {
  -Id : Guid
  -OwnerId : String
  -IsDeleted : bool
}

GroupPostsController --> PostService
PostService --> PostRepository
PostService --> GroupRepository
PostRepository --> AppDbContext
GroupRepository --> AppDbContext
PostRepository --> Post
GroupRepository --> Group

note bottom of PostService
  Allowed only to the post author or the group owner
  (UnauthorizedAccessException otherwise); sets IsDeleted = true
end note
@enduml
