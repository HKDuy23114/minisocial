@startuml class_search
title Search Module (Group / User / Post) - Class Diagram
hide circle
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor white
  BorderColor black
  FontName "Arial"
  FontStyle bold
}

package "FE.Web (MVC)" {
  class "Web.SearchController" as WebSearch {
    -_api : ApiClient
    +Index(q : String) : IActionResult
  }
  class ApiClient {
    +SearchAsync(q : String, limit : int) : SearchResponse
  }
}

package "API (Presentation)" {
  class SearchController {
    -_searchService : ISearchService
    +Search(query : String, limit : int) : ActionResult<SearchResponse>
  }
}

package "Application (BLL)" {
  interface ISearchService {
    +SearchAsync(query : String, limit : int) : SearchResponse
  }
  class SearchService {
    -_searchRepository : ISearchRepository
    +SearchAsync(query : String, limit : int) : SearchResponse
    -{static} MapUser(user : AppUser) : SearchUserResponse
    -{static} MapGroup(group : Group) : SearchGroupResponse
    -{static} MapPost(post : Post) : PostResponse
  }
}

package "Application.DTOs" {
  class SearchResponse {
    +Query : String
    +UserTotal : int
    +GroupTotal : int
    +PostTotal : int
    +Users : SearchUserResponse[]
    +Groups : SearchGroupResponse[]
    +Posts : PostResponse[]
  }
  class SearchUserResponse {
    +Id : String
    +DisplayName : String
    +AvatarUrl : String
    +Bio : String
    +CreatedDate : DateTime
  }
  class SearchGroupResponse {
    +Id : Guid
    +Name : String
    +Description : String
    +AvatarUrl : String
    +OwnerId : String
    +MemberCount : int
    +CreatedDate : DateTime
  }
}

package "Infrastructure (DAL)" {
  interface ISearchRepository {
    +SearchAsync(query : String, limit : int) : SearchRepositoryResult
  }
  class SearchRepositoryResult {
    +UserTotal : int
    +GroupTotal : int
    +PostTotal : int
    +Users : AppUser[]
    +Groups : Group[]
    +Posts : Post[]
  }
  class SearchRepository {
    -_context : AppDbContext
    +SearchAsync(query : String, limit : int) : SearchRepositoryResult
  }
  class AppDbContext {
    +Users : DbSet<AppUser>
    +Groups : DbSet<Group>
    +Posts : DbSet<Post>
  }
}

WebSearch --> ApiClient
ApiClient ..> SearchController : HTTP/JSON
SearchController --> ISearchService
SearchService ..|> ISearchService
SearchService --> ISearchRepository
SearchRepository ..|> ISearchRepository
SearchRepository --> AppDbContext
SearchRepository ..> SearchRepositoryResult
SearchService ..> SearchResponse
SearchResponse *-- SearchUserResponse
SearchResponse *-- SearchGroupResponse
@enduml
